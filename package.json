{
  "name": "app",
  "private": true,
  "packageManager": "npm@10.8.2",
  "scripts": {
    "dev": "next dev --webpack -H 0.0.0.0 -p 3000",
    "prebuild": "node -e \"const f=require('fs');const p='.next';const ok=(x)=>{try{return f.existsSync(x)}catch(e){return false}};if(ok(p)&&(!ok(p+'/BUILD_ID')||!ok(p+'/server/pages-manifest.json')))try{f.rmSync(p,{recursive:true,force:true,maxRetries:5,retryDelay:300})}catch(e){}\"",
    "build": "next build --webpack || (node -e \"try{require('fs').rmSync('.next',{recursive:true,force:true,maxRetries:5,retryDelay:300})}catch(e){}\" && next build --webpack)",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "next lint",
    "test": "vitest run",
    "migrate:trip-attachments": "tsx --require dotenv/config scripts/migrate-trip-attachments-to-local.ts"
  },
  "prisma": {
    "seed": "tsx --require dotenv/config scripts/safe-seed.ts"
  },
